async function telegram(method, body) {
  const response = await fetch(
    `https://api.telegram.org/bot${BOT_TOKEN}/${method}`,
    {
      method: 'POST',
      headers: {
        'content-type': 'application/json'
      },
      body: JSON.stringify(body)
    }
  );

  const data = await response.json();

  if (!response.ok || !data.ok) {
    throw new Error(
      data.description || `Telegram API error: ${method}`
    );
  }

  return data.result;
}

// Создание таблиц базы данных
async function initDb() {
  await pool.query(`
    CREATE TABLE IF NOT EXISTS game_users (
      telegram_id BIGINT PRIMARY KEY,
      coins BIGINT NOT NULL DEFAULT 0,
      created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
    );

    CREATE TABLE IF NOT EXISTS payments (
      payload UUID PRIMARY KEY,
      telegram_id BIGINT NOT NULL,
      product_id TEXT NOT NULL,
      stars INTEGER NOT NULL,
      status TEXT NOT NULL DEFAULT 'pending',
      telegram_charge_id TEXT UNIQUE,
      created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
      paid_at TIMESTAMPTZ
    );

    CREATE TABLE IF NOT EXISTS owned_weapons (
      telegram_id BIGINT NOT NULL,
      weapon_id TEXT NOT NULL,
      acquired_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
      PRIMARY KEY (telegram_id, weapon_id)
    );
  `);
}

// Проверка подлинности Telegram initData
function verifyInitData(initData) {
  if (
    typeof initData !== 'string' ||
    !initData ||
    initData.length > 10000
  ) {
    throw new Error('Missing Telegram initData');
  }

  const params = new URLSearchParams(initData);
  const receivedHash = params.get('hash');
  const authDate = Number(params.get('auth_date'));

  if (!receivedHash || !Number.isFinite(authDate)) {
    throw new Error('Invalid Telegram initData');
  }

  if (Math.abs(Date.now() / 1000 - authDate) > 86400) {
    throw new Error('Telegram session expired; reopen the game');
  }

  params.delete('hash');

  const checkString = [...params.entries()]
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([k, v]) => `${k}=${v}`)
    .join('\n');

  const secretKey = crypto
    .createHmac('sha256', 'WebAppData')
    .update(BOT_TOKEN)
    .digest();

  const calculated = crypto
    .createHmac('sha256', secretKey)
    .update(checkString)
    .digest();

  let received;

  try {
    received = Buffer.from(receivedHash, 'hex');
  } catch {
    throw new Error('Invalid Telegram hash');
  }

  if (
    received.length !== calculated.length ||
    !crypto.timingSafeEqual(received, calculated)
  ) {
    throw new Error('Telegram initData signature mismatch');
  }

  const userRaw = params.get('user');

  if (!userRaw) {
    throw new Error('Telegram user is missing');
  }

  const user = JSON.parse(userRaw);

  if (!user || !user.id) {
    throw new Error('Invalid Telegram user');
  }

  return String(user.id);
}

// Авторизация пользователя
function requireTelegramUser(req, res, next) {
  try {
    req.telegramId = verifyInitData(
      req.get('x-telegram-init-data')
    );

    next();
  } catch (error) {
    res.status(401).json({
      ok: false,
      error: error.message
    });
  }
}

