require('dotenv').config();
const express = require('express');
const crypto = require('crypto');
const { Pool } = require('pg');

const app = express();
app.use(express.json({ limit: '256kb' }));

// CORS для Telegram Mini App
app.use((req, res, next) => {
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type, x-telegram-init-data');
  if (req.method === 'OPTIONS') return res.sendStatus(204);
  next();
});

const { BOT_TOKEN, DATABASE_URL, WEBHOOK_SECRET } = process.env;

if (!BOT_TOKEN || !DATABASE_URL || !WEBHOOK_SECRET) {
  console.error('Missing BOT_TOKEN, DATABASE_URL, or WEBHOOK_SECRET environment variable.');
  process.exit(1);
}

const pool = new Pool({
  connectionString: DATABASE_URL,
  ssl: process.env.PGSSL === 'true'
    ? { rejectUnauthorized: false }
    : undefined
});

