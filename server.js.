// Данные игрока
app.get('/api/me', requireTelegramUser, async (req, res) => {
  try {
    const userId = req.telegramId;

    await pool.query(
      'INSERT INTO game_users (telegram_id) VALUES ($1) ON CONFLICT DO NOTHING',
      [userId]
    );

    const [user, weapons] = await Promise.all([
      pool.query(
        'SELECT coins FROM game_users WHERE telegram_id = $1',
        [userId]
      ),
      pool.query(
        'SELECT weapon_id FROM owned_weapons WHERE telegram_id = $1 ORDER BY weapon_id',
        [userId]
      )
    ]);

    res.json({
      ok: true,
      coins: Number(user.rows[0].coins),
      ownedWeapons: weapons.rows.map(r => r.weapon_id)
    });

  } catch (error) {
    console.error('GET /api/me failed:', error);

    res.status(500).json({
      ok: false,
      error: 'Could not load player data'
    });
  }
});

// Создание счёта Telegram Stars
app.post('/api/stars/invoice', requireTelegramUser, async (req, res) => {
  const productId = req.body && req.body.productId;
  const product = PRODUCTS[productId];

  if (!product) {
    return res.status(400).json({
      ok: false,
      error: 'Unknown product'
    });
  }

  const client = await pool.connect();
  let payload;

  try {
    payload = crypto.randomUUID();

    await client.query('BEGIN');

    await client.query(
      'INSERT INTO game_users (telegram_id) VALUES ($1) ON CONFLICT DO NOTHING',
      [req.telegramId]
    );

    await client.query(
      'INSERT INTO payments (payload, telegram_id, product_id, stars) VALUES ($1, $2, $3, $4)',
      [payload, req.telegramId, productId, product.stars]
    );

    await client.query('COMMIT');

    const invoiceLink = await telegram('createInvoiceLink', {
      title: product.title,
      description: product.type === 'coins'
        ? '100 монет для Zombie-Wave'
        : `Постоянное разблокирование: ${product.title}`,
      payload,
      provider_token: '',
      currency: 'XTR',
      prices: [
        {
          label: product.title,
          amount: product.stars
        }
      ]
    });

    res.json({
      ok: true,
      invoiceLink
    });

  } catch (error) {
    await client.query('ROLLBACK').catch(() => {});

    console.error('Invoice creation failed:', error);

    res.status(502).json({
      ok: false,
      error: 'Could not create Telegram invoice'
    });

  } finally {
    client.release();
  }
});

// Подтверждение оплаты перед списанием Stars
async function handlePreCheckout(query) {
  const result = await pool.query(
    `SELECT payload FROM payments
     WHERE payload = $1
     AND telegram_id = $2
     AND stars = $3
     AND status = 'pending'`,
    [
      query.invoice_payload,
      String(query.from.id),
      query.total_amount
    ]
  );

  const valid =
    query.currency === 'XTR' &&
    result.rowCount === 1;

  await telegram('answerPreCheckoutQuery', {
    pre_checkout_query_id: query.id,
    ok: valid,
    ...(valid ? {} : {
      error_message: 'Платёж не найден или его параметры не совпадают. Попробуйте открыть магазин заново.'
    })
  });
}

// Выдача товара после успешной оплаты
async function handleSuccessfulPayment(message) {
  const payment = message.successful_payment;
  const telegramId = String(message.from.id);

  if (payment.currency !== 'XTR') {
    throw new Error('Unexpected payment currency');
  }

  const client = await pool.connect();

  try {
    await client.query('BEGIN');

    const found = await client.query(
      `SELECT product_id, stars, status
       FROM payments
       WHERE payload = $1
       AND telegram_id = $2
       FOR UPDATE`,
      [
        payment.invoice_payload,
        telegramId
      ]
    );

    if (found.rowCount !== 1) {
      throw new Error('Payment payload not found for Telegram user');
    }

    const row = found.rows[0];

    if (Number(row.stars) !== payment.total_amount) {
      throw new Error('Payment amount mismatch');
    }

    if (row.status === 'paid') {
      await client.query('COMMIT');
      return;
    }

    if (row.status !== 'pending') {
      throw new Error('Payment is not pending');
    }

    await client.query(
      'INSERT INTO game_users (telegram_id) VALUES ($1) ON CONFLICT DO NOTHING',
      [telegramId]
    );

    const product = PRODUCTS[row.product_id];

    if (!product) {
      throw new Error('Unknown product in payment record');
    }

    if (product.type === 'coins') {
      await client.query(
        'UPDATE game_users SET coins = coins + $1 WHERE telegram_id = $2',
        [product.amount, telegramId]
      );
    } else {
      await client.query(
        'INSERT INTO owned_weapons (telegram_id, weapon_id) VALUES ($1, $2) ON CONFLICT DO NOTHING',
        [telegramId, row.product_id]
      );
    }

    await client.query(
      `UPDATE payments
       SET status = 'paid',
           telegram_charge_id = $1,
           paid_at = NOW()
       WHERE payload = $2`,
      [
        payment.telegram_payment_charge_id,
        payment.invoice_payload
      ]
    );

    await client.query('COMMIT');

  } catch (error) {
    await client.query('ROLLBACK').catch(() => {});
    throw error;

  } finally {
    client.release();
  }
}

// Webhook Telegram
app.post('/telegram/webhook', async (req, res) => {
  if (
    req.get('x-telegram-bot-api-secret-token') !== WEBHOOK_SECRET
  ) {
    return res.sendStatus(401);
  }

  res.sendStatus(200);

  try {
    const update = req.body;

    if (update.pre_checkout_query) {
      await handlePreCheckout(update.pre_checkout_query);
    }

    if (
      update.message &&
      update.message.successful_payment
    ) {
      await handleSuccessfulPayment(update.message);
    }

    if (
      update.message &&
      typeof update.message.text === 'string' &&
      update.message.text.startsWith('/paysupport')
    ) {
      await telegram('sendMessage', {
        chat_id: update.message.chat.id,
        text: 'По вопросам оплаты Zombie-Wave напишите администратору игры.'
      });
    }

  } catch (error) {
    console.error('Webhook update handling failed:', error);
  }
});

